# Copy to .env.local. Add the same values in Vercel > Settings > Environment Variables.
# NEVER commit filled secrets. Only NEXT_PUBLIC_SITE_URL is intentionally public.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SANDBOX=true
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
SHIPPING_ORIGIN_CEP=
HANDLING_DAYS=3
RESEND_API_KEY=
EMAIL_FROM=
PRIVACY_EMAIL=
LEGAL_BUSINESS_NAME=
BUSINESS_TAX_ID=
WHATSAPP_NUMBER=
# Generate unique random secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
ORDER_TOKEN_SECRET=
RATE_LIMIT_SALT=
# Keep false until catalog, company details and sandbox payment tests are confirmed.
LIVE_CHECKOUT_ENABLED=false
